{
  "name": "@nex/cli",
  "version": "1.2.3",
  "private": true,
  "description": "Main CLI application for nex",
  "bin": {
    "nex": "./dist/nex.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/nex.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/nex-cli run build --filter=!@nex/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@nex/adapters": "workspace:*",
    "@nex/bootstrap": "workspace:*",
    "@nex/contracts": "workspace:*",
    "@nex/core": "workspace:*",
    "@nex/dynamic-workflow-runtime": "workspace:*",
    "@nex/i18n": "workspace:*",
    "@nex/provider-node": "link:../../../../packages/provider-node",
    "@nex/shared": "link:../../../../packages/shared",
    "@nex/shared-types": "workspace:*",
    "@nex/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
