{
  "name": "@nex/bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v4-replay": {
      "types": "./dist/nex-protocol-v4/replay.d.ts",
      "import": "./dist/nex-protocol-v4/replay.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@nex/adapters": "workspace:*",
    "@nex/contracts": "workspace:*",
    "@nex/core": "workspace:*",
    "@nex/dynamic-workflow": "workspace:*",
    "@nex/dynamic-workflow-runtime": "workspace:*",
    "@nex/i18n": "workspace:*",
    "@nex/provider": "link:../../../../packages/provider",
    "@nex/provider-node": "link:../../../../packages/provider-node",
    "@nex/shared": "link:../../../../packages/shared",
    "diff": "^9.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/yazl": "^3.3.1",
    "@nex/formal-proof": "link:../../../../packages/formal-proof",
    "yazl": "^3.3.1"
  }
}
